# Proxy URL used by local development and builds.
# Replace with the URL of an instance you operate.
EXPO_PUBLIC_PROXY_BASE=https://your-proxy.example.com

# Keep the real value in .env.local; never commit deployment-specific URLs.
# Copy this file to apps/mobile/.env.local when building the mobile app.

# Server deployment settings belong in the hosting environment, not source control.
# VPS_HOST=
# VPS_USER=
# VPS_SSH_KEY=
