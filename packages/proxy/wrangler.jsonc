{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonora-music-proxy",
  "main": "server/worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "unsafe_eval"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
