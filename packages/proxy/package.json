{
  "name": "@sonora-music/proxy",
  "version": "0.1.0",
  "description": "Portable InnerTube proxy for Sonora Music. Runs on Node (VPS/Docker) and Cloudflare Workers from the same codebase.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/node.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:cf": "wrangler deploy",
    "dev:cf": "wrangler dev",
    "check:cf": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@hono/node-server": "^1.13.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
